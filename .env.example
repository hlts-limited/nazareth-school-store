# Copy this file to .env and fill in the values.

# --- App ---
APP_URL="http://localhost:3000"
# Long random string used to sign cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Database (PostgreSQL) ---
# Local Docker database from docker-compose.yml:
DATABASE_URL="postgresql://nazareth:nazareth@localhost:5432/nazareth_store?schema=public"

# --- File storage ---
# Folder for receipts, product photos and backups. Keep it OUTSIDE any public folder.
STORAGE_DIR="./storage"

# --- Paystack ---
# Leave empty during development to use the built-in simulated checkout.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# --- Notifications (optional; messages are logged to the console when empty) ---
RESEND_API_KEY=""
EMAIL_FROM="Nazareth School Store <store@yourschool.com.ng>"
TERMII_API_KEY=""
TERMII_SENDER_ID="NazSchool"

# --- Backups ---
# Password used to encrypt every backup file. Store it somewhere safe (not only on the server):
# without it, backups cannot be restored.
BACKUP_PASSWORD="change-me-backup-password"

# --- Scheduled jobs ---
# Secret the daily job must send (header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="change-me-cron-secret"

# --- First Super Admin (used by the seed script) ---
# This is the owner account: it is hidden from Staff & roles and can't be disabled, reset or have its roles changed there.
SEED_ADMIN_EMAIL="admin@yourschool.com.ng"
SEED_ADMIN_PASSWORD="ChangeMe!2026"
# Add demo parents, pupils and orders (true for testing, false for the real school)
SEED_DEMO="true"
