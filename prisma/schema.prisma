// Nazareth School Store — database schema
// Money is stored in whole naira (Int). Paystack amounts are converted to kobo at the edge.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- People & access ----------

enum UserType {
  PARENT
  STAFF
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

model User {
  id              String     @id @default(uuid())
  type            UserType
  status          UserStatus @default(INVITED)
  title           String?
  firstName       String
  lastName        String
  email           String?    @unique
  phone           String?    @unique
  passwordHash    String?
  totpSecret      String?
  inviteToken     String?    @unique
  inviteExpiresAt DateTime?
  consentAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  roles         UserRole[]
  guardianships Guardian[]
  cartItems     CartItem[]
  orders        Order[]
  notifications Notification[]
  employee      Employee?

  @@index([lastName])
}

model Role {
  id          String     @id // accountant | registrar | secretary | admin
  name        String
  permissions String[]
  users       UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

enum SessionKind {
  PARENT
  PUPIL
  STAFF
}

model Session {
  id           String      @id // sha256 of the cookie token
  kind         SessionKind
  userId       String?
  pupilId      String?
  remember     Boolean     @default(false)
  userAgent    String?
  ip           String?
  createdAt    DateTime    @default(now())
  lastActiveAt DateTime    @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokeReason String?

  @@index([userId])
  @@index([pupilId])
}

model ViewAsSession {
  id         String    @id @default(uuid())
  adminId    String
  sessionId  String // the admin's own session
  targetKind String // parent | pupil
  targetId   String
  reason     String
  startedAt  DateTime  @default(now())
  expiresAt  DateTime
  endedAt    DateTime?
}

model LoginAttempt {
  id        String   @id @default(uuid())
  key       String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// ---------- School ----------

model Class {
  id           String        @id @default(uuid())
  name         String        @unique
  sortOrder    Int
  pupils       Pupil[]
  items        ItemClass[]
  applications Application[]
}

enum PupilStatus {
  ACTIVE
  ARCHIVED
}

model Pupil {
  id        String      @id @default(uuid())
  firstName String
  lastName  String
  regNumber String      @unique
  gender    String?
  classId   String
  class     Class       @relation(fields: [classId], references: [id])
  pinHash   String?
  status    PupilStatus @default(ACTIVE)
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  guardians   Guardian[]
  lines       OrderLine[]
  cartItems   CartItem[]
  wallet      Wallet?
  wishlist    WishlistItem[]
  application Application?

  @@index([lastName])
  @@index([classId])
}

model Guardian {
  parentId     String
  pupilId      String
  relationship String  @default("Parent")
  isPrimary    Boolean @default(true)
  parent       User    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  pupil        Pupil   @relation(fields: [pupilId], references: [id], onDelete: Cascade)

  @@id([parentId, pupilId])
}

// ---------- Catalogue & stock ----------

model Category {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  color     String     @default("#4A4446")
  sortOrder Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  items     Item[]
}

model Item {
  id           String         @id @default(uuid())
  sku          String         @unique
  name         String
  description  String?
  categoryId   String
  category     Category       @relation(fields: [categoryId], references: [id])
  price        Int
  imageKey     String?
  isActive     Boolean        @default(true)
  reorderLevel Int            @default(5)
  hasVariants  Boolean        @default(false)
  // A pile (e.g. core textbooks) is sold as one product but made of real books with their own stock.
  // Its price is kept equal to the sum of its books; it holds no stock itself.
  isPile       Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  variants     ItemVariant[]
  classes      ItemClass[]
  wishlist     WishlistItem[]
  pileParts    PilePart[]     @relation("PileParts")
  inPiles      PilePart[]     @relation("PileBooks")

  @@index([categoryId])
}

/// One book inside a pile. A book in any pile is only sold as part of that pile.
model PilePart {
  id        String @id @default(uuid())
  pileId    String
  pile      Item   @relation("PileParts", fields: [pileId], references: [id], onDelete: Cascade)
  bookId    String
  book      Item   @relation("PileBooks", fields: [bookId], references: [id])
  qty       Int    @default(1)
  sortOrder Int    @default(0)

  @@unique([pileId, bookId])
  @@index([bookId])
}

// Which classes an item is for, and whether it is on that class's required booklist
model ItemClass {
  itemId       String
  classId      String
  isCompulsory Boolean @default(false)
  qty          Int     @default(1)
  item         Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  class        Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([itemId, classId])
}

// Every item has at least one variant ("Standard"); sized items have one per size.
model ItemVariant {
  id            String          @id @default(uuid())
  itemId        String
  item          Item            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  label         String          @default("Standard")
  sku           String          @unique
  priceOverride Int?
  onHand        Int             @default(0)
  reserved      Int             @default(0)
  sortOrder     Int             @default(0)
  movements     StockMovement[]
  lines         OrderLine[]
  cartItems     CartItem[]
}

enum StockMovementType {
  RESTOCK
  SALE
  ADJUSTMENT
  RETURN
}

model StockMovement {
  id        String            @id @default(uuid())
  variantId String
  variant   ItemVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type      StockMovementType
  qty       Int // signed: + adds to on-hand, - removes
  reason    String?
  orderId   String?
  userId    String?
  createdAt DateTime          @default(now())

  @@index([variantId, createdAt])
}

// ---------- Cart & orders ----------

model CartItem {
  id        String      @id @default(uuid())
  parentId  String
  pupilId   String
  variantId String
  qty       Int
  createdAt DateTime    @default(now())
  parent    User        @relation(fields: [parentId], references: [id], onDelete: Cascade)
  pupil     Pupil       @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  variant   ItemVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([parentId, pupilId, variantId])
}

model WishlistItem {
  pupilId   String
  itemId    String
  createdAt DateTime @default(now())
  pupil     Pupil    @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([pupilId, itemId])
}

enum OrderStatus {
  PENDING_PAYMENT
  AWAITING_VERIFICATION
  PAYMENT_REJECTED
  PART_PAID
  PAYMENT_APPROVED
  PACKING
  READY
  PARTIALLY_HANDED_OUT
  HANDED_OUT
  CANCELLED
}

enum PaymentMethod {
  PAYSTACK
  TRANSFER
  WALLET
}

model Order {
  id             String        @id @default(uuid())
  number         Int           @unique @default(autoincrement())
  parentId       String
  parent         User          @relation(fields: [parentId], references: [id])
  status         OrderStatus   @default(PENDING_PAYMENT)
  method         PaymentMethod
  subtotal       Int
  walletUsed     Int           @default(0)
  amountReceived Int           @default(0)
  excess         Int           @default(0)
  pickupCode     String?
  rejectReason   String?
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines    OrderLine[]
  payments Payment[]
  events   OrderEvent[]
  invoice  Invoice?
  pickups  Pickup[]

  @@index([parentId, createdAt])
  @@index([status])
}

enum LineStatus {
  PENDING
  PACKING
  READY
  AWAITING_STOCK
  HANDED_OUT
  CANCELLED
}

model OrderLine {
  id           String      @id @default(uuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pupilId      String
  pupil        Pupil       @relation(fields: [pupilId], references: [id])
  variantId    String
  variant      ItemVariant @relation(fields: [variantId], references: [id])
  itemName     String // copied at checkout so later edits don't change past orders
  variantLabel String
  qty          Int
  unitPrice    Int
  status       LineStatus  @default(PENDING)
  // Set when the line is a book bought as part of a pile (copied at checkout)
  pileItemId   String?
  pileName     String?
  // False while a pile book is awaiting stock: no stock is held for it until it arrives
  reserved     Boolean     @default(true)

  @@index([orderId])
  @@index([pupilId])
}

model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  message   String
  actorName String?
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

enum PaymentStatus {
  PENDING
  AWAITING_VERIFICATION
  APPROVED
  PART_PAID
  REJECTED
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method          PaymentMethod
  amountDue       Int
  amountReceived  Int?
  status          PaymentStatus @default(PENDING)
  paystackRef     String?       @unique
  verifiedById    String?
  verifiedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime      @default(now())
  receipts        Receipt[]

  @@index([orderId])
  @@index([status])
}

model Receipt {
  id            String   @id @default(uuid())
  paymentId     String
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  fileKey       String
  fileName      String
  mimeType      String
  size          Int
  sha256        String
  bankName      String
  amountClaimed Int
  transferDate  DateTime
  uploadedAt    DateTime @default(now())

  @@index([sha256])
}

enum InvoiceStatus {
  DRAFT
  APPROVED
  VOID
}

model Invoice {
  id           String        @id @default(uuid())
  orderId      String        @unique
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status       InvoiceStatus @default(DRAFT)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime      @default(now())
}

model Pickup {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  collectedByName String
  relationship    String
  itemCount       Int
  handedOutById   String
  createdAt       DateTime @default(now())
}

// ---------- Wallet ----------

model Wallet {
  id           String              @id @default(uuid())
  pupilId      String              @unique
  pupil        Pupil               @relation(fields: [pupilId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

enum WalletTxType {
  OVERPAYMENT_CREDIT
  CANCELLED_ORDER_CREDIT
  CHECKOUT_DEBIT
  REFUND
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
}

model WalletTransaction {
  id        String       @id @default(uuid())
  walletId  String
  wallet    Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type      WalletTxType
  amount    Int // signed
  orderId   String?
  reason    String?
  actorName String?
  movable   Boolean      @default(false) // overpayment on a multi-child order: parent may move it once
  createdAt DateTime     @default(now())

  @@index([walletId, createdAt])
}

// ---------- Admissions ----------

// A period when families can apply for a session. formFee 0 = free form.
model AdmissionWindow {
  id                 String        @id @default(uuid())
  session            String // e.g. "2027/2028"
  opensAt            DateTime
  closesAt           DateTime
  formFee            Int           @default(0)
  note               String?
  resultsPublishedAt DateTime?
  createdAt          DateTime      @default(now())
  applications       Application[]
  examSlots          ExamSlot[]

  @@index([opensAt, closesAt])
}

model ExamSlot {
  id           String          @id @default(uuid())
  windowId     String
  window       AdmissionWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  startsAt     DateTime
  venue        String
  capacity     Int
  note         String?
  applications Application[]

  @@index([windowId, startsAt])
}

enum ApplicationStatus {
  AWAITING_PAYMENT // form fee not paid yet
  SUBMITTED
  EXAM_SCHEDULED
  ADMITTED
  WAITLISTED
  NOT_ADMITTED
  ENROLLED
  WITHDRAWN
}

model Application {
  id              String            @id @default(uuid())
  number          String            @unique // NZA27-XXXXXX, random so results can't be guessed in sequence
  accessTokenHash String // sha256 of the private link token given to the family
  windowId        String
  window          AdmissionWindow   @relation(fields: [windowId], references: [id])
  classId         String
  class           Class             @relation(fields: [classId], references: [id])
  status          ApplicationStatus @default(SUBMITTED)

  surname        String
  otherNames     String
  dateOfBirth    DateTime
  gender         String
  previousSchool String?
  parentName     String
  relationship   String
  parentPhone    String // normalised 0XXXXXXXXXX
  parentEmail    String?
  address        String
  details        Json // the rest of the form: second parent, nationality, health notes, etc.

  feeAmount Int       @default(0)
  feeRef    String?   @unique
  feePaidAt DateTime?

  examSlotId   String?
  examSlot     ExamSlot? @relation(fields: [examSlotId], references: [id], onDelete: SetNull)
  decisionNote String?
  decidedById  String?
  decidedAt    DateTime?
  pupilId      String?   @unique
  pupil        Pupil?    @relation(fields: [pupilId], references: [id], onDelete: SetNull)

  submittedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  documents   ApplicationDocument[]

  @@index([windowId, status])
  @@index([surname])
}

model ApplicationDocument {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          String // passport | birth | result | testimonial
  fileKey       String
  fileName      String
  mimeType      String
  size          Int
  uploadedAt    DateTime    @default(now())

  @@unique([applicationId, kind])
}

// ---------- Public website content ----------

// Announcement bar messages, shown between startsAt and endsAt
model Notice {
  id          String    @id @default(uuid())
  text        String
  link        String?
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([startsAt, endsAt])
}

model Event {
  id          String    @id @default(uuid())
  title       String
  startsAt    DateTime
  endsAt      DateTime?
  venue       String?
  description String?
  photoKey    String? // optional photo shown on the event card (stored under events/)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([startsAt])
}

/// School news for the website: results, awards, trips. Staff write them in Website → News.
model NewsPost {
  id          String   @id @default(uuid())
  slug        String   @unique // the address: /news/<slug>
  title       String
  summary     String? // one or two lines for the list and the homepage
  body        String // plain text; a blank line starts a new paragraph
  photoKey    String? // stored under news/
  published   Boolean  @default(true)
  publishedAt DateTime @default(now()) // the date shown; newest first
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, publishedAt])
}

model GalleryPhoto {
  id        String   @id @default(uuid())
  album     String // e.g. "Inter-house sports 2026"; photos are grouped by this name
  caption   String?
  fileKey   String
  thumbKey  String? // a small copy (600 px) for the photo grid; older photos have none
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([album, sortOrder])
}

// Messages sent from the website's Contact page
model Enquiry {
  id          String    @id @default(uuid())
  name        String
  email       String?
  phone       String?
  subject     String
  message     String
  handledAt   DateTime?
  handledById String?
  createdAt   DateTime  @default(now())

  @@index([handledAt, createdAt])
}

// ---------- System ----------

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channels  String // e.g. "sms,email"
  title     String
  body      String
  readAt    DateTime?
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// Append-only: prisma/sql/harden.sql adds a trigger that blocks UPDATE and DELETE.
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actorName String
  actorRole String
  action    String
  entity    String
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum BackupKind {
  MANUAL
  AUTOMATIC
  SAFETY
}

model Backup {
  id          String     @id @default(uuid())
  fileName    String
  fileKey     String
  size        Int
  checksum    String
  kind        BackupKind
  createdById String?
  createdBy   String
  counts      Json
  createdAt   DateTime   @default(now())
}

// ---------- Staff app: staff records, documents, bank details ----------

enum EmploymentType {
  FULL_TIME
  PART_TIME
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum BankStatus {
  NONE // no bank details yet
  PENDING // entered, waiting for the Bursar
  VERIFIED // approved by the Bursar: can be paid
  REJECTED
}

model Employee {
  id                 String         @id @default(uuid())
  staffCode          String         @unique // NS-001
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  phone              String? // WhatsApp number for links (kept here: a teacher may also have a parent account with the same number)
  gender             String?
  dateOfBirth        DateTime?      @db.Date
  section            String // pre-school | school-a | school-b | admin
  branch             String? // the branch they're deployed to and clock in at: pre-school | school-a | school-b (HR transfers them)
  position           String // Class Teacher, Bursar, Driver…
  isTeacher          Boolean        @default(false)
  hireDate           DateTime       @db.Date
  employmentType     EmploymentType @default(FULL_TIME)
  status             EmployeeStatus @default(ACTIVE)
  monthlyGrossKobo   Int // money is integer kobo
  // Statutory identifiers for the tax and remittance schedules
  tin                String?
  pfaName            String?
  rsaPin             String?
  nhfNumber          String?
  nhisNumber         String?
  annualRentNaira    Int            @default(0) // declared yearly rent, for rent relief (whole naira)
  statutoryOverrides Json? // e.g. {"pension":{"off":true,"reason":"on probation"}}
  // Bank: the account number and name are encrypted; only the last 4 digits are kept in the clear
  bankCode           String?
  bankName           String?
  accountNumberEnc   String?
  accountLast4       String?
  accountNameEnc     String?
  accountNameChecked Boolean        @default(false) // name came from Paystack's account check
  bankStatus         BankStatus     @default(NONE)
  bankNote           String?
  bankReviewedById   String?
  bankReviewedAt     DateTime?
  paystackRecipient  String? // transfer recipient code, reset when the bank changes
  attendanceConsentAt DateTime? // accepted the photo and location notice (NDPA 2023)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  documents          EmployeeDocument[]
  attendance         Attendance[]
  captureTokens      CaptureToken[]
  leaveRequests      LeaveRequest[]
  payrollItems       PayrollItem[]
  adjustments        PayrollAdjustment[]

  @@index([section])
}

enum DocStatus {
  PENDING
  APPROVED
  REJECTED
}

model EmployeeDocument {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind         String // cv | certificate | trcn | id | passport | guarantor | reference | contract | other
  fileKey      String
  fileName     String
  mimeType     String
  size         Int
  status       DocStatus @default(PENDING)
  note         String? // HR's reason when rejected
  expiresAt    DateTime? @db.Date // ID or licence expiry, for reminders
  uploadedById String
  uploadedAt   DateTime  @default(now())
  reviewedById String?
  reviewedAt   DateTime?

  @@index([employeeId, kind])
  @@index([status])
}

// ---------- Staff app: attendance ----------

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT // no clock-in by Close day, no leave, not a holiday
  LEAVE // approved leave
  HOLIDAY
}

model Attendance {
  id               String           @id @default(uuid())
  employeeId       String
  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date             DateTime         @db.Date // the school day (Lagos)
  status           AttendanceStatus
  clockInAt        DateTime?
  clockOutAt       DateTime?
  inPhotoKey       String?
  outPhotoKey      String?
  photoDeletedAt   DateTime? // photos are deleted after 31 days; the record stays
  inLat            Float?
  inLng            Float?
  outLat           Float?
  outLng           Float?
  qrVerified       Boolean          @default(false)
  manualNote       String? // why HR or the Proprietor clocked them by hand
  manualBy         String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

/** Issued after a valid QR scan; the photo must come back with it within 60 seconds, once. */
model CaptureToken {
  id         String    @id @default(uuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind       String // in | out
  issuedAt   DateTime  @default(now())
  expiresAt  DateTime
  usedAt     DateTime?

  @@index([employeeId])
}

model Holiday {
  id   String   @id @default(uuid())
  date DateTime @unique @db.Date
  name String
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id         String      @id @default(uuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       String // annual | sick | maternity | paternity | compassionate | other
  fromDate   DateTime    @db.Date
  toDate     DateTime    @db.Date
  reason     String?
  status     LeaveStatus @default(PENDING)
  decidedBy  String?
  decidedAt  DateTime?
  note       String?
  createdAt  DateTime    @default(now())

  @@index([employeeId, status])
  @@index([fromDate, toDate])
}

// ---------- Staff app: payroll ----------

enum PayrollStatus {
  DRAFT
  STATUTORY_REVIEWED
  TAX_REVIEWED
  DEFAULTS_REVIEWED // ready for approval
  APPROVED
  PAID
  LOCKED
}

model PayrollRun {
  id                 String        @id @default(uuid())
  period             String        @unique // YYYY-MM
  status             PayrollStatus @default(DRAFT)
  rates              Json? // the rates and tax bands this run used, copied at stage 1
  statutoryCalcBy    String?
  statutoryCalcAt    DateTime?
  statutoryRevBy     String?
  statutoryRevAt     DateTime?
  taxCalcBy          String?
  taxCalcAt          DateTime?
  taxRevBy           String?
  taxRevAt           DateTime?
  defaultsCalcBy     String?
  defaultsCalcAt     DateTime?
  defaultsRevBy      String?
  defaultsRevAt      DateTime?
  preparerIds        String[] // everyone who calculated or reviewed a stage: none of them may approve
  approvedBy         String?
  approvedById       String?
  approvedAt         DateTime?
  sentBackNote       String?
  paidAt             DateTime?
  lockedAt           DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  items              PayrollItem[]
}

model PayrollItem {
  id            String     @id @default(uuid())
  runId         String
  run           PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  // Monthly amounts in kobo (annual figures are in `lines`)
  grossKobo     Int
  pensionKobo   Int        @default(0)
  nhfKobo       Int        @default(0)
  nhisKobo      Int        @default(0)
  taxKobo       Int        @default(0)
  penaltiesKobo Int        @default(0)
  carryKobo     Int        @default(0) // penalties carried to next month
  netKobo       Int        @default(0)
  held          Boolean    @default(false) // not paid: bank not verified
  heldReason    String?
  lines         Json? // stage-by-stage breakdown for the payslip
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  payments      SalaryPayment[]

  @@unique([runId, employeeId])
}

model PayrollAdjustment {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period     String // YYYY-MM
  kind       String // penalty | waiver
  amountKobo Int
  reason     String
  by         String
  byId       String
  createdAt  DateTime @default(now())

  @@index([period])
}

enum SalaryPaymentStatus {
  PENDING // sent to Paystack, waiting for the result
  SUCCESS
  FAILED
  REVERSED
}

/** One Paystack transfer of one salary. The database allows only one PENDING or SUCCESS payment per payslip. */
model SalaryPayment {
  id           String              @id @default(uuid())
  itemId       String
  item         PayrollItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  attempt      Int
  reference    String              @unique // nzs_sal_YYYYMM_<item>_<attempt>
  amountKobo   Int
  status       SalaryPaymentStatus @default(PENDING)
  live         Boolean // a live (not test) Paystack key was used
  transferCode String?
  failReason   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([itemId, attempt])
}
